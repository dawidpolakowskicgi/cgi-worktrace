{
  "name": "tavri",
  "productName": "Tavri",
  "version": "0.4.0",
  "description": "Tavri — your work, clearly recorded. A local activity journal and CLI.",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "icons": "node scripts/render-brand.mjs && node scripts/generate-icons.mjs",
    "start": "npm run desktop",
    "test": "./tests/run.sh",
    "test:desktop": "node tests/test_desktop_core.mjs && node tests/test_desktop_renderer.mjs && node --test tests/test_team_reports.mjs",
    "test:desktop:screenshot": "node tests/test_desktop_screenshot.mjs",
    "test:desktop:integration": "electron tests/test_desktop_integration.cjs",
    "package:mac": "node scripts/package-macos.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "axe-core": "^4.14.0",
    "electron": "^42.11.18"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
